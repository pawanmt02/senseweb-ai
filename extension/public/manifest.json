{
  "manifest_version": 3,
  "name": "SenseWeb AI",
  "version": "1.0.0",
  "description": "AI-powered accessibility assistant that dynamically remediates web interfaces for users with cognitive, motor, or visual disabilities.",
  "action": {
    "default_title": "SenseWeb AI"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/scanner.js",
        "content/captioner.js",
        "content/simplifier.js",
        "content/profiles.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "sidePanel", "tabs", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"]
}
